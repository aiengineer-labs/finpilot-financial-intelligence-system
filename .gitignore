# FinPilot — keep secrets, private financial data, and build output out of Git.

# --- Secrets and local environment -------------------------------------------
.env
.env.*
!.env.example
.envrc
.pypirc

# --- Private financial data and database artefacts ---------------------------
# Real statements are never committed. Only versioned synthetic fixtures are allowed.
uploads/
private-data/
*.csv
!evaluation/datasets/*.csv
!evaluation/security/*.csv
!apps/web/public/samples/*.csv
*.db
*.sqlite3
*.sqlite3-journal
*.dump
*.sql
*.rdb

# --- Python (apps/api) ---------------------------------------------------------
.venv/
venv/
env/
__pycache__/
*.py[codz]
*$py.class
*.egg-info/
build/
dist/
.pytest_cache/
.hypothesis/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover
*.lcov
.mypy_cache/
.dmypy.json
.ruff_cache/
.tox/
.nox/

# --- Node / Next.js (apps/web) -------------------------------------------------
node_modules/
.next/
out/
.vercel/
.pnpm-store/
*.tsbuildinfo
npm-debug.log*
pnpm-debug.log*

# --- Evaluation output -----------------------------------------------------------
evaluation/promptfoo/.promptfoo/
evaluation/reports/promptfoo-*.html

# --- Tool caches, logs, and OS/editor noise ------------------------------------
.cache/
*.log
*.pid
.DS_Store
Thumbs.db
.idea/
*.swp
